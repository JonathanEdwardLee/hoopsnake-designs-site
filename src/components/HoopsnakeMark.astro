---
interface Props {
  class?: string;
  variant?: 'emblem' | 'lockup';
  labelled?: boolean;
}

const { class: className = 'hsd-mark', variant = 'emblem', labelled = false } = Astro.props;

const assets = {
  emblem: {
    src: '/images/brand/hoopsnake-emblem.png',
    width: 1254,
    height: 1254,
  },
  lockup: {
    src: '/images/brand/hoopsnake-lockup.png',
    width: 2172,
    height: 724,
  },
} as const;

const asset = assets[variant];
---

<img
  class={className}
  src={asset.src}
  width={asset.width}
  height={asset.height}
  alt={labelled ? 'Hoopsnake Designs' : ''}
  decoding="async"
  role={labelled ? undefined : 'presentation'}
/>

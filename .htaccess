# Hoopsnake Designs — repository-root deploy mapping for Hostinger Git
#
# Hostinger Advanced → Git deploys the selected branch into the hosting
# destination (default: public_html). Only explicit public URL prefixes are
# allowed; everything else is denied before any repository file is served.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Default-deny public boundary: allow only intended site URLs
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !^/_astro/
  RewriteCond %{REQUEST_URI} !^/images/
  RewriteCond %{REQUEST_URI} !^/favicon\.svg$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  RewriteCond %{REQUEST_URI} !^/api/project-review\.php$
  RewriteRule ^ - [F,L]

  # Internal publish mapping into committed site/ tree
  RewriteRule ^$ site/index.html [L]
  RewriteRule ^(.+)$ site/$1 [L]
</IfModule>

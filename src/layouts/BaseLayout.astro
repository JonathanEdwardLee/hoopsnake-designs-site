---
import HoopsnakeMark from '@/components/HoopsnakeMark.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hoopsnake Designs — Websites, apps, and digital products by Jonathan Edward Lee',
  description = 'Hoopsnake Designs is Jonathan Edward Lee’s studio for distinctive websites, apps, and digital tools. Custom work for businesses, creative projects, and people who want something better than a template.',
} = Astro.props;

const canonical = 'https://hoopsnakedesigns.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/images/brand/hoopsnake-favicon.png" type="image/png" sizes="192x192" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-lockup" href="#main">
          <HoopsnakeMark class="brand-lockup-img" variant="lockup" labelled />
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="#featured">Portfolio</a>
          <a class="nav-compact-hide" href="#what-i-build">What I Build</a>
          <a href="#about">About</a>
          <a class="nav-compact-hide" href="#working-together">Working Together</a>
          <a href="#project-review">Start a Project</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-grid">
          <div class="footer-identity">
            <HoopsnakeMark class="footer-mark" variant="emblem" />
            <strong>Hoopsnake Designs</strong>
          </div>
          <p class="footer-note">
            Websites, apps, and digital products by Jonathan Edward Lee. Project inquiries go through the form on this page — no public mailbox is published here.
          </p>
          <div class="footer-links">
            <a href="#featured">Portfolio</a>
            <a href="#project-review">Start a Project</a>
            <a href="#boundaries">Scope & privacy</a>
          </div>
          <p class="footer-note">© {new Date().getFullYear()} Hoopsnake Designs.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

{
  "name": "hoopsnake-designs-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/package-release.mjs",
    "build:production": "node scripts/build-production.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:php": "php vendor/bin/phpunit --configuration phpunit.xml",
    "test:apache": "bash scripts/apache-integration-test.sh",
    "report:release": "node scripts/report-release-tree.mjs",
    "verify:release": "bash scripts/verify-release-artifact.sh",
    "capture:portfolio": "node scripts/capture-portfolio-images.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.14.0",
    "astro": "^7.3.2",
    "eslint": "^9.24.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

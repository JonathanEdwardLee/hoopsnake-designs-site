---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HoopsnakeMark from '@/components/HoopsnakeMark.astro';
import {
  budgetBands,
  capabilities,
  featuredPortfolio,
  supportOptions,
  portfolioItems,
  primaryGoals,
  processStages,
  projectTypes,
  timingOptions,
} from '@/data/site';
---

<BaseLayout>
  <section class="section-block hero-grid" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Hoopsnake Designs · Jonathan Edward Lee</p>
      <h1 id="hero-title">I design and build distinctive websites, apps, and digital tools.</h1>
      <p>
        Custom work for businesses, creative projects, and people who want something better than a template. You work with Jonathan directly.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#portfolio">View Portfolio</a>
        <a class="button-secondary" href="#project-review">Start a Project</a>
      </div>
    </div>
    <div class="hero-device" aria-hidden="true">
      <div class="hoopsnake-loop" data-motion-loop>
        <div class="loop-interior">
          <HoopsnakeMark class="hero-mark" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-block featured-block" id="featured" aria-labelledby="featured-title">
    <p class="section-label">Featured</p>
    <h2 id="featured-title" class="section-title">Recent work, shown at a scale you can actually judge.</h2>
    <p class="section-lead">
      These are real products and sites. Owned PIM and Junkfeathers projects demonstrate how Jonathan designs and builds; they are not independent paid-client case studies.
    </p>

    <div class="featured-stack">
      {featuredPortfolio.map((item, index) => (
        <article class={`feature-piece layout-${item.layout}`}>
          <div class="feature-visual">
            <img
              src={item.image}
              alt={item.imageAlt}
              width="1280"
              height="720"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={index === 0 ? 'high' : undefined}
            />
          </div>
          <div class="feature-copy">
            <p class="relationship-tag">{item.relationship}</p>
            <p class="tech-label">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a href={item.href} target="_blank" rel="noopener noreferrer">View public project</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block" id="portfolio" aria-labelledby="portfolio-title">
    <span id="selected-work"></span>
    <p class="section-label">Portfolio</p>
    <h2 id="portfolio-title" class="section-title">Portfolio</h2>
    <p class="section-lead">
      Directories, guided tools, maps, interactive characters, machine interfaces, and a shipped Android recorder — different problems, same author.
    </p>
    <div class="portfolio-mosaic">
      {portfolioItems.map((item) => (
        <article class={`portfolio-entry layout-${item.layout}`}>
          <div class="portfolio-visual">
            <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" width="640" height="400" />
          </div>
          <div class="portfolio-body">
            <p class="relationship-tag">{item.relationship}</p>
            <p class="tech-label">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a href={item.href} target="_blank" rel="noopener noreferrer">View public project</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block" id="what-i-build" aria-labelledby="build-title">
    <p class="section-label">What I Build</p>
    <h2 id="build-title" class="section-title">Websites, apps, and tools with a clear job.</h2>
    <p class="section-lead">
      The work stays specific. If a project needs something larger than a focused build, that gets its own conversation and proposal.
    </p>
    <div class="capability-list">
      {capabilities.map((item) => (
        <article class="capability-row">
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block" id="about" aria-labelledby="about-title">
    <p class="section-label">About</p>
    <div class="about-grid">
      <h2 id="about-title" class="section-title">You work with Jonathan.</h2>
      <div class="about-copy">
        <p>
          Hoopsnake Designs is Jonathan Edward Lee’s design and development studio. He designs and builds websites, apps, and digital tools for businesses, creative projects, and people who want authored work instead of a template.
        </p>
        <p>
          There is no account team in between. Inquiries are read by Jonathan. Fit is checked before a call is scheduled, and a proposal is written before build starts.
        </p>
      </div>
    </div>
  </section>

  <section class="section-block" id="how-we-work" aria-labelledby="process-title">
    <p class="section-label">How We'll Work Together</p>
    <h2 id="process-title" class="section-title">Review. Conversation. Proposal. Build.</h2>
    <ol class="process-list">
      {processStages.map((stage) => (
        <li class="process-step">
          <span class="tech-label">{stage.number}</span>
          <strong>{stage.title}</strong>
          <p>{stage.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block" id="working-together" aria-labelledby="working-title">
    <span id="launch-system"></span>
    <p class="section-label">Working Together</p>
    <h2 id="working-title" class="section-title">A clear starting point, then a written proposal.</h2>
    <div class="working-grid">
      <div>
        <p class="section-lead">
          Custom websites and focused product work typically start at $3,500. That figure is a quote floor, not a packaged price list. Larger apps, custom systems, and ongoing support are scoped separately after review.
        </p>
        <p class="section-lead" style="margin-top: 1.25rem;">
          Payment details, timeline, and deliverables live in the proposal — not as pressure on this page.
        </p>
      </div>
      <div class="working-notes" id="boundaries">
        <p><strong>Not a template install.</strong> The page is meant to show the work itself.</p>
        <p><strong>No public AI chat.</strong> Visitor project content is not sent to an AI provider.</p>
        <p><strong>Privacy for inquiries.</strong> Use the form for project inquiries only. Do not submit credentials, payment information, or unnecessary sensitive data.</p>
        <p><strong>After launch.</strong> One-time launch is the default. Ongoing support requires a separate scope.</p>
      </div>
    </div>
  </section>

  <section class="section-block" id="project-fit" aria-labelledby="fit-title" data-project-fit>
    <p class="section-label">Project Fit</p>
    <h2 id="fit-title" class="section-title">Check fit before you write the full brief.</h2>
    <p class="section-lead">
      This quick check helps prefill the review form. It does not generate a binding quote or promise acceptance.
    </p>
    <form class="fit-shell" data-fit-form>
      <div class="fit-steps">
        <div class="fit-field">
          <label for="fit_project_type">Project type</label>
          <select id="fit_project_type" name="fit_project_type" required>
            <option value="">Select project type</option>
            {projectTypes.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="fit-field">
          <label for="fit_primary_goal">Primary goal</label>
          <select id="fit_primary_goal" name="fit_primary_goal" required>
            <option value="">Select primary goal</option>
            {primaryGoals.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="fit-field">
          <label for="fit_budget_band">Budget band</label>
          <select id="fit_budget_band" name="fit_budget_band" required>
            <option value="">Select budget band</option>
            {budgetBands.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="fit-field">
          <label for="fit_timing">Timing</label>
          <select id="fit_timing" name="fit_timing" required>
            <option value="">Select timing</option>
            {timingOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
      </div>
      <div class="fit-result" data-fit-result hidden>
        <p><strong>Fit summary:</strong> <span data-fit-summary></span></p>
        <p class="fit-note" data-fit-note></p>
        <button class="button-secondary" type="button" data-fit-continue>Prefill project review form</button>
      </div>
    </form>
  </section>

  <section class="section-block" id="project-review" aria-labelledby="review-title" data-review-root>
    <p class="section-label">Start a Project</p>
    <h2 id="review-title" class="section-title">Tell me about your project</h2>
    <p class="section-lead">
      Share the essentials below. Jonathan reviews fit before scheduling a call and does not promise acceptance.
    </p>

    <form class="form-grid two-col" data-review-form novalidate>
      <div class="form-field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        <span class="field-error" id="error-name" data-field-error="name"></span>
      </div>
      <div class="form-field">
        <label for="business_name">Business / project name</label>
        <input id="business_name" name="business_name" type="text" autocomplete="organization" required maxlength="160" />
        <span class="field-error" id="error-business_name" data-field-error="business_name"></span>
      </div>
      <div class="form-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" />
        <span class="field-error" id="error-email" data-field-error="email"></span>
      </div>
      <div class="form-field">
        <label for="project_type">Project type</label>
        <select id="project_type" name="project_type" required>
          <option value="">Select project type</option>
          {projectTypes.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-project_type" data-field-error="project_type"></span>
      </div>
      <div class="form-field">
        <label for="current_url">Current site / product URL (optional)</label>
        <input id="current_url" name="current_url" type="url" inputmode="url" maxlength="500" />
        <span class="field-error" id="error-current_url" data-field-error="current_url"></span>
      </div>
      <div class="form-field">
        <label for="budget_band">Budget band</label>
        <select id="budget_band" name="budget_band" required>
          <option value="">Select budget band</option>
          {budgetBands.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-budget_band" data-field-error="budget_band"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="problem">Problem / desired outcome</label>
        <textarea id="problem" name="problem" required maxlength="4000"></textarea>
        <span class="field-error" id="error-problem" data-field-error="problem"></span>
      </div>
      <div class="form-field">
        <label for="timing">Timing</label>
        <select id="timing" name="timing" required>
          <option value="">Select timing</option>
          {timingOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-timing" data-field-error="timing"></span>
      </div>
      <div class="form-field">
        <label for="ongoing_support">Expected ongoing support</label>
        <select id="ongoing_support" name="ongoing_support" required>
          <option value="">Select support expectation</option>
          {supportOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-ongoing_support" data-field-error="ongoing_support"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="must_have">Must-have features / integrations</label>
        <textarea id="must_have" name="must_have" required maxlength="2000"></textarea>
        <span class="field-error" id="error-must_have" data-field-error="must_have"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="decision_path">Decision-maker / approval path</label>
        <textarea id="decision_path" name="decision_path" required maxlength="1200"></textarea>
        <span class="field-error" id="error-decision_path" data-field-error="decision_path"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="notes">Optional notes</label>
        <textarea id="notes" name="notes" maxlength="2000"></textarea>
        <span class="field-error" id="error-notes" data-field-error="notes"></span>
      </div>

      <div class="form-trap" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p class="form-disclosure" style="grid-column: 1 / -1;">
        This form is for project inquiries only. Do not submit credentials, payment information, or unnecessary sensitive data.
      </p>

      <div class="form-error-summary" data-form-error-summary role="alert" aria-live="polite" hidden style="grid-column: 1 / -1;"></div>

      <div style="grid-column: 1 / -1; display: grid; gap: 1rem;">
        <button class="button-primary" type="submit" data-form-submit>Submit project review</button>
        <output class="form-status" data-form-status role="status" aria-live="polite"></output>
      </div>
    </form>

    <div data-form-success hidden style="margin-top: 2rem;">
      <p class="form-disclosure">
        Submission received. Jonathan reviews fit before scheduling a call. Acceptance is not promised.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="../scripts/project-fit.ts"></script>
<script src="../scripts/form.ts"></script>
<script src="../scripts/motion-loop.ts"></script>

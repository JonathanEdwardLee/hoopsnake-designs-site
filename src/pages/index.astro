---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  budgetBands,
  supportOptions,
  portfolioItems,
  primaryGoals,
  projectTypes,
  timingOptions,
} from '@/data/site';
---

<BaseLayout>
  <section class="section-block hero-grid" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-price">Projects start at $3,500.</p>
      <h1 id="hero-title">Hoopsnake Launch System</h1>
      <p>
        Premium custom website and qualified-lead system for small businesses, creators, and service operators who need more than a generic template — without hiring a large agency.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#project-review">Request a project review</a>
        <a class="button-secondary" href="#selected-work">View selected work</a>
      </div>
    </div>
    <div class="hero-device" aria-hidden="true">
      <div class="hoopsnake-loop">
        <div class="loop-ring"></div>
        <div class="loop-path">
          <span class="loop-node"></span>
          <span class="loop-node"></span>
          <span class="loop-node"></span>
          <span class="loop-node"></span>
        </div>
        <div class="loop-core">
          <strong>Launch</strong>
          <span>Qualified lead path</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="breadth-title">
    <p class="section-label">Capability breadth</p>
    <h2 id="breadth-title" class="section-title">Built for focused launches, with room for more.</h2>
    <p class="section-lead">
      The hero offer is the Launch System. Separately scoped work may include apps, interactive experiences, custom tools, optional AI integrations, and unusual technology.
    </p>
    <div class="breadth-grid" style="margin-top: 2rem;">
      <article class="chip-card"><strong>Websites</strong><p>Custom one-page or small-site architecture with premium presentation.</p></article>
      <article class="chip-card"><strong>Apps</strong><p>Bounded product work when scope, timeline, and ownership are clear.</p></article>
      <article class="chip-card"><strong>Interactive</strong><p>Character-led, game-like, or experiential web interfaces.</p></article>
      <article class="chip-card"><strong>Custom tools</strong><p>Workflow tools, integrations, and focused internal systems.</p></article>
      <article class="chip-card"><strong>Optional AI</strong><p>Future server-side assistance only when lead volume justifies it — not in V1.</p></article>
    </div>
  </section>

  <section class="section-block" id="selected-work" aria-labelledby="portfolio-title">
    <p class="section-label">Selected work</p>
    <h2 id="portfolio-title" class="section-title">Proof from owned builds and Jonathan's properties.</h2>
    <p class="section-lead">
      These examples show real design instincts across directories, guided UX, regional discovery, character-led interaction, machine-interface art direction, and native product work.
    </p>
    <div class="portfolio-grid" style="margin-top: 2rem;">
      {portfolioItems.map((item) => (
        <article class="portfolio-card">
          <div class="portfolio-visual" style={`--accent: ${item.accent}`}>
            <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" width="640" height="400" />
            <span>{item.label}</span>
          </div>
          <div class="portfolio-body">
            <p class="relationship-tag">{item.relationship}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a href={item.href} target="_blank" rel="noopener noreferrer">View public project ↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block" id="launch-system" aria-labelledby="launch-title">
    <p class="section-label">Launch System first</p>
    <h2 id="launch-title" class="section-title">What the Launch System includes — and what stays separate.</h2>
    <div class="launch-stack" style="margin-top: 2rem;">
      <article class="launch-card">
        <strong>Standard Launch System scope</strong>
        <ul>
          <li>Custom one-page or small-site architecture appropriate to the project</li>
          <li>Mobile-first responsive design with performance and accessibility in mind</li>
          <li>Technical SEO and privacy foundation</li>
          <li>Qualified project-review form</li>
          <li>One bounded integration</li>
          <li>Two consolidated revision rounds</li>
          <li>Explicit handoff documentation</li>
          <li>Proposed 14-day launch-defect correction window</li>
        </ul>
      </article>
      <article class="launch-card">
        <strong>Separate scopes</strong>
        <ul>
          <li>Larger apps, games, commerce platforms, or backends</li>
          <li>Ongoing marketing retainers or open-ended support</li>
          <li>Public AI chat or visitor-content processing</li>
          <li>Payment processing or recurring platform expansion</li>
        </ul>
        <p style="margin-top: 1rem;">Payment milestones are discussed in proposals — not published here as binding policy.</p>
      </article>
    </div>
  </section>

  <section class="section-block machine-panel" id="project-fit" aria-labelledby="fit-title" data-project-fit>
    <p class="section-label">Project Fit</p>
    <h2 id="fit-title" class="section-title">Check fit before you write the full brief.</h2>
    <p class="section-lead">
      This quick check helps prefill the review form. It does not generate a binding quote or promise acceptance.
    </p>
    <form class="fit-shell" data-fit-form style="margin-top: 2rem;">
      <div class="fit-steps">
        <div class="fit-field">
          <label for="fit_project_type">Project type</label>
          <select id="fit_project_type" name="fit_project_type" required>
            <option value="">Select project type</option>
            {projectTypes.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="fit-field">
          <label for="fit_primary_goal">Primary goal</label>
          <select id="fit_primary_goal" name="fit_primary_goal" required>
            <option value="">Select primary goal</option>
            {primaryGoals.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="fit-field">
          <label for="fit_budget_band">Budget band</label>
          <select id="fit_budget_band" name="fit_budget_band" required>
            <option value="">Select budget band</option>
            {budgetBands.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="fit-field">
          <label for="fit_timing">Timing</label>
          <select id="fit_timing" name="fit_timing" required>
            <option value="">Select timing</option>
            {timingOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>
      </div>
      <div class="fit-result" data-fit-result hidden>
        <p><strong>Fit summary:</strong> <span data-fit-summary></span></p>
        <p class="fit-note" data-fit-note></p>
        <button class="button-secondary" type="button" data-fit-continue>Prefill project review form</button>
      </div>
    </form>
  </section>

  <section class="section-block" aria-labelledby="process-title">
    <p class="section-label">Process</p>
    <h2 id="process-title" class="section-title">Review first. Call only if qualified.</h2>
    <div class="process-grid" style="margin-top: 2rem;">
      <article class="process-step"><strong>01 · Review</strong><p>Submit the project review form asynchronously. Hoopsnake reviews fit before any scheduling.</p></article>
      <article class="process-step"><strong>02 · Scoped call</strong><p>If the project appears aligned, a focused call clarifies goals, constraints, and decision path.</p></article>
      <article class="process-step"><strong>03 · Proposal</strong><p>Scope, timeline, deliverables, and investment are documented clearly before build begins.</p></article>
      <article class="process-step"><strong>04 · Build + staging</strong><p>Mobile-first implementation with performance, accessibility, and technical SEO foundations.</p></article>
      <article class="process-step"><strong>05 · Two revisions</strong><p>Two consolidated revision rounds keep the launch focused and bounded.</p></article>
      <article class="process-step"><strong>06 · Handoff + launch</strong><p>Explicit handoff, launch support, and a proposed 14-day launch-defect correction window.</p></article>
    </div>
  </section>

  <section class="section-block" id="boundaries" aria-labelledby="faq-title">
    <p class="section-label">Boundaries / FAQ</p>
    <h2 id="faq-title" class="section-title">Clear scope beats vague promises.</h2>
    <div class="faq-grid" style="margin-top: 2rem;">
      <article class="faq-item">
        <strong>Is this a template install?</strong>
        <p>No. The page itself is meant to prove design ability — authored, premium, and memorable rather than generic agency filler.</p>
      </article>
      <article class="faq-item">
        <strong>Do you publish payment milestones here?</strong>
        <p>No. Larger apps, commerce, backends, ongoing marketing, and open-ended support are scoped separately in proposals.</p>
      </article>
      <article class="faq-item">
        <strong>What about AI chat?</strong>
        <p>V1 does not include public AI chat or send visitor project content to any AI provider.</p>
      </article>
      <article class="faq-item">
        <strong>What happens after I submit?</strong>
        <p>Submission received means the inquiry is in review. Hoopsnake evaluates fit before scheduling a call and does not promise acceptance.</p>
      </article>
      <article class="faq-item">
        <strong>Privacy for inquiries</strong>
        <p>The form is for project inquiries only. Do not submit credentials, payment information, or unnecessary sensitive data.</p>
      </article>
      <article class="faq-item">
        <strong>Support after launch</strong>
        <p>One-time launch is the default. Ongoing support, marketing, or platform expansion requires a separate scope.</p>
      </article>
    </div>
  </section>

  <section class="section-block machine-panel" id="project-review" aria-labelledby="review-title" data-review-root>
    <p class="section-label">Qualified Project Review</p>
    <h2 id="review-title" class="section-title">Request a project review</h2>
    <p class="section-lead">
      Share the essentials below. Hoopsnake reviews fit before scheduling a call and does not promise acceptance.
    </p>

    <form class="form-grid two-col" data-review-form style="margin-top: 2rem;" novalidate>
      <div class="form-field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        <span class="field-error" id="error-name" data-field-error="name"></span>
      </div>
      <div class="form-field">
        <label for="business_name">Business / project name</label>
        <input id="business_name" name="business_name" type="text" autocomplete="organization" required maxlength="160" />
        <span class="field-error" id="error-business_name" data-field-error="business_name"></span>
      </div>
      <div class="form-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" />
        <span class="field-error" id="error-email" data-field-error="email"></span>
      </div>
      <div class="form-field">
        <label for="project_type">Project type</label>
        <select id="project_type" name="project_type" required>
          <option value="">Select project type</option>
          {projectTypes.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-project_type" data-field-error="project_type"></span>
      </div>
      <div class="form-field">
        <label for="current_url">Current site / product URL (optional)</label>
        <input id="current_url" name="current_url" type="url" inputmode="url" maxlength="500" />
        <span class="field-error" id="error-current_url" data-field-error="current_url"></span>
      </div>
      <div class="form-field">
        <label for="budget_band">Budget band</label>
        <select id="budget_band" name="budget_band" required>
          <option value="">Select budget band</option>
          {budgetBands.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-budget_band" data-field-error="budget_band"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="problem">Problem / desired outcome</label>
        <textarea id="problem" name="problem" required maxlength="4000"></textarea>
        <span class="field-error" id="error-problem" data-field-error="problem"></span>
      </div>
      <div class="form-field">
        <label for="timing">Timing</label>
        <select id="timing" name="timing" required>
          <option value="">Select timing</option>
          {timingOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-timing" data-field-error="timing"></span>
      </div>
      <div class="form-field">
        <label for="ongoing_support">Expected ongoing support</label>
        <select id="ongoing_support" name="ongoing_support" required>
          <option value="">Select support expectation</option>
          {supportOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span class="field-error" id="error-ongoing_support" data-field-error="ongoing_support"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="must_have">Must-have features / integrations</label>
        <textarea id="must_have" name="must_have" required maxlength="2000"></textarea>
        <span class="field-error" id="error-must_have" data-field-error="must_have"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="decision_path">Decision-maker / approval path</label>
        <textarea id="decision_path" name="decision_path" required maxlength="1200"></textarea>
        <span class="field-error" id="error-decision_path" data-field-error="decision_path"></span>
      </div>
      <div class="form-field" style="grid-column: 1 / -1;">
        <label for="notes">Optional notes</label>
        <textarea id="notes" name="notes" maxlength="2000"></textarea>
        <span class="field-error" id="error-notes" data-field-error="notes"></span>
      </div>

      <div class="form-trap" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p class="form-disclosure" style="grid-column: 1 / -1;">
        This form is for project inquiries only. Do not submit credentials, payment information, or unnecessary sensitive data.
      </p>

      <div class="form-error-summary" data-form-error-summary role="alert" aria-live="polite" hidden style="grid-column: 1 / -1;"></div>

      <div class="turnstile-frame" style="grid-column: 1 / -1;">
        <div data-turnstile-widget></div>
      </div>

      <div style="grid-column: 1 / -1; display: grid; gap: 1rem;">
        <button class="button-primary" type="submit" data-form-submit>Submit project review</button>
        <output class="form-status" data-form-status role="status" aria-live="polite"></output>
      </div>
    </form>

    <div data-form-success hidden style="margin-top: 2rem;">
      <p class="form-disclosure">
        Submission received. Hoopsnake reviews fit before scheduling a call. Acceptance is not promised.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="../scripts/project-fit.ts"></script>
<script src="../scripts/form.ts"></script>
